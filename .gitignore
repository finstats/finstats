/target

# Runtime data: the database holds your users, IP addresses and Jellyfin API key.
/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.backup.db
*.db.*

# Personal history exports: these carry user names, IP addresses and viewing history
*.jsonl
backup_*
streamystats-backup-*.json
*-upload.tmp
*-upload.tmp.rows
# FinStats' own backups (finstats-backup-*.jsonl.gz, and a half-written .part) and a Tautulli backup, which carries
# every Plex user's token and e-mail
*.jsonl.gz
*.jsonl.gz.part
finstats-backup-*
*.zip

# Secrets and local overrides
.env
.env.*
docker-compose.override.yml

# Third-party UX checklist (https://uxgoodpatterns.com): a local reference, not ours to redistribute
ux-rules.md

# Local QA suite: end-to-end, performance and browser checks run before a release
/qa/
